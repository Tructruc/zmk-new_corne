#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/* Long hold to soft-off, so it can't happen by accident. */
&soft_off { hold-time-ms = <3000>; };

/ {
    /* Encoder click on FN: advance the status screen to its next page. */
    behaviors {
        page_next: page_next {
            compatible = "beopylar,behavior-display-page";
            #binding-cells = <1>;
        };
        page_prev: page_prev {
            compatible = "beopylar,behavior-display-page";
            #binding-cells = <1>;
        };
    };

    /* Encoder rotation on FN flips the status screen page: clockwise to the
     * next one, counter-clockwise back. Only rotation is wrapped, so the click
     * keeps falling through to the mute key on BASE. */
    page_flip: page_flip {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&page_next 1>, <&page_prev (-1)>;
    };

    /* Layer-dependent encoder: volume on BASE, RGB brightness on NUM. */
    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    keymap {
        compatible = "zmk,keymap";

        /* BASE – the five columns each hand actually uses; outer columns unbound.
         *
         * OS layout: Beopylar QG (Kalamine, beopylar.toml, fr).
         * The firmware sends *positions*, and the OS turns a position into its
         * character, so the letters below are the plain US positions and must
         * not be shuffled. What each one types with this layout:
         *
         *   q w e r t   ->  b ¨ o p y     (¨ = the 1dk dead key: é è à ç œ ...)
         *   a s d f g   ->  a u e i ,
         *   z x c v b   ->  z k x . w
         *   y u i o p   ->  - v d l j
         *   h j k l ;   ->  c t s r n
         *   n m , . /   ->  m q g h f
         *
         * Shift and AltGr are both thumbs, so with these 30 keys alone the whole
         * layout is reachable except the number row: 144 of its 187 characters.
         *   AltGr      -> @ < > $ % ^ & * ' " ` ~ [ ] { } ( ) = + - / _ \ | ; : ? !
         *   Shift      -> capitals, ; : ? and the number row's symbols on NUM
         *   1dk (W)    -> é è à ç œ ù î û ê ô ñ æ ß ŭ and the dead keys ´ ` ^ ¨ ~
         *
         *   tap left  thumb 1   -> NUM   (toggle, so both hands keep typing;
         *                                  tap again to leave.)
         *   encoder click        -> ESC   (mute on FN)
         *   hold left  thumb 3   -> FN    (bluetooth, underglow, media, reset)
         *   5-way: arrows, ENTER on press.  Right thumb 2 is a plain BSPC so
         *   that holding it repeats.
         *   FN + encoder turn  -> flip the status screen (status, link); while a
         *   BLE profile is open for pairing the screen shows that instead
         */
        default_layer {
            display-name = "BASE";
            bindings = <
&none     &kp Q    &kp W    &kp E    &kp R    &kp T                                 &kp UP                       &kp Y     &kp U     &kp I     &kp O     &kp P     &none
&none     &kp A    &kp S    &kp D    &kp F    &kp G                       &kp LEFT  &kp ENTER   &kp RIGHT             &kp H     &kp J     &kp K     &kp L     &kp SEMI  &none
&none     &kp Z    &kp X    &kp C    &kp V    &kp B               &kp ESC            &kp DOWN                     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &none
                                     &tog 1        &mt LSHFT TAB  &lt 2 ENTER                          &mt LCTRL SPACE  &kp BSPC   &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* NUM – toggled from the encoder click, so both hands stay free.  The
         * number row is the only thing these 30 keys cannot reach on their own.
         * The OS layout still decides what the digits look like: Shift gives
         * the number row's symbols (! @ # $ % ^ & * ( )), AltGr its subscripts.
         */
        number_layer {
            display-name = "NUM";
            bindings = <
&none     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                                &trans                       &kp N6   &kp N7   &kp N8   &kp N9   &kp N0    &none
&none     &trans      &trans      &trans      &trans      &trans                       &trans  &trans  &trans                &trans   &trans   &trans   &trans   &trans    &none
&none     &trans      &trans      &trans      &trans      &trans               &trans         &trans                       &trans   &trans   &trans   &trans   &trans    &none
                                     &trans  &trans  &trans                                     &trans  &trans  &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };

        /* FN – bluetooth, underglow, media, function keys, reset. */
        fn_layer {
            display-name = "FN";
            bindings = <
&none     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &trans                        &bt BT_CLR  &out OUT_USB  &out OUT_BLE  &sys_reset  &bootloader  &none
&none     &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI     &trans  &trans  &trans                &rgb_ug RGB_HUD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &soft_off  &trans  &none
&none     &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_MUTE    &trans                    &kp C_MUTE     &trans                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none
                                     &trans  &trans  &trans                                     &trans  &trans  &trans
            >;

            sensor-bindings = <&page_flip>;
        };
    };
};
